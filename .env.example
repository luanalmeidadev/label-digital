NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública final, sem barra no fim. Preencha depois de conectar o domínio.
SITE_URL=

# Use "homologacao" somente no ambiente de testes. Em produção, deixe vazio.
NEXT_PUBLIC_APP_ENV=

# Cloudflare Turnstile. Use chaves reais em Preview/Production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Monitoramento de erros (Sentry). O DSN pode ser público; o token não pode.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

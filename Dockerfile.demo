FROM node:22-alpine AS builder

WORKDIR /app

# Enable corepack for pnpm/yarn/npm (we'll just use npm as per standard)
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# We must provide some dummy env vars if build requires them, 
# but next.config.ts only checks required ones on VERCEL_ENV
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Note: In production we use start, but this needs next binary, which is in node_modules/.bin
CMD ["npm", "start"]
